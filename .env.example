# ==============================================================================
# NightAuth Telegram Bot - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram Bot Token (from https://t.me/BotFather)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# ------------------------------------------------------------------------------
# 2. NightAuth Business API Endpoint
# ------------------------------------------------------------------------------
# Default official endpoint: https://nightauth.org/api/business
# For self-hosted instances: http://localhost:13100/api/business
NIGHTAUTH_API_URL=https://nightauth.org/api/business

# ------------------------------------------------------------------------------
# 3. NightAuth Multi-App Configuration
# ------------------------------------------------------------------------------
# You can configure multiple authorized applications so this bot can manage
# all of your products from a single Telegram chat.
#
# Format 1 (Recommended - Comma separated pairs: "AppName:biz_key,AppName2:biz_key"):
NIGHTAUTH_APPS="MainApp:biz_abcdef1234567890abcdef1234567890,SecondApp:biz_123456abcdef7890123456abcdef7890"

# Format 2 (Alternative - JSON string):
# NIGHTAUTH_APPS='[{"name":"MainApp","apiKey":"biz_abcdef1234567890abcdef1234567890"},{"name":"SecondApp","apiKey":"biz_123456abcdef7890123456abcdef7890"}]'

# Format 3 (Single App Fallback):
# NIGHTAUTH_APP_NAME="MainApp"
# NIGHTAUTH_BUSINESS_KEY="biz_abcdef1234567890abcdef1234567890"

# ------------------------------------------------------------------------------
# 4. Access Control (Admin Protection)
# ------------------------------------------------------------------------------
# Comma-separated list of numeric Telegram User IDs permitted to execute administrative actions
# (e.g. generating keys, banning users, resetting HWID, deleting).
# You can find your Telegram ID by messaging @userinfobot or @rawdatabot.
ADMIN_USER_IDS="123456789,987654321"

# ------------------------------------------------------------------------------
# 5. Localization
# ------------------------------------------------------------------------------
# Default fallback language: en (supported: en, es, de, fr, it, pl, pt, ru, tr, zh)
# Users can also change their language preference at any time via /lang, /language,
# or by clicking the '🌐 Language' button on the dashboard.
DEFAULT_LANGUAGE=en

